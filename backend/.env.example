# Gemini AI (optional, only needed for the /api/v1/ai/chat endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Authentication (required for /api/v1/auth/login; login fails closed without these).
# Values are read case-insensitively by pydantic-settings.
API_USERNAME=admin
# Generate with: python -m app.core.security
API_PASSWORD_HASH=PBKDF2$SHA256$210000$<salt_base64>$<key_base64>
# Random secret of at least 32 bytes for signing JWTs
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=SmartSchoolBackend
JWT_AUDIENCE=SmartSchoolClients
JWT_EXPIRE_MINUTES=60

# Comma-separated allowed CORS origins (never "*" together with credentials)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5197
