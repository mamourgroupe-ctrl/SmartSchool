param([string]$BaseUrl="http://127.0.0.1:5197",[int]$TimeoutSec=5,[int]$SlowThresholdMs=2000)
$dir=Split-Path -Parent $MyInvocation.MyCommand.Path; $log=Join-Path $dir "api-monitor.log"; $stateFile=Join-Path $dir "api-monitor-state.json"
function Log([string]$level,[string]$msg){Add-Content -Path $log -Value ("{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"),$level,$msg) -Encoding UTF8}
function Alert([string]$title,[string]$msg){Log "ALERT" ("$title - $msg");try{& msg.exe * "$title`n$msg" 2>$null|Out-Null}catch{}}
$state=[pscustomobject]@{IsHealthy=$true;ConsecutiveFailures=0};if(Test-Path $stateFile){try{$state=Get-Content $stateFile -Raw|ConvertFrom-Json}catch{}}
$status=0;$err="";$sw=[Diagnostics.Stopwatch]::StartNew();try{$r=Invoke-WebRequest "$BaseUrl/" -UseBasicParsing -TimeoutSec $TimeoutSec -ErrorAction Stop;$status=[int]$r.StatusCode}catch{$err=$_.Exception.Message};$sw.Stop();$latency=[int]$sw.ElapsedMilliseconds;$healthy=($status -ge 200 -and $status -lt 300 -and $latency -le $SlowThresholdMs)
if($healthy){if(-not [bool]$state.IsHealthy){Alert "SmartSchoolAPI RECOVERED" "status=$status latency=${latency}ms"};Log "OK" "status=$status latency=${latency}ms";$state.IsHealthy=$true;$state.ConsecutiveFailures=0}else{$state.ConsecutiveFailures=[int]$state.ConsecutiveFailures+1;$detail=if($err){$err}else{"status=$status latency=${latency}ms"};if([bool]$state.IsHealthy -or $state.ConsecutiveFailures % 5 -eq 0){Alert "SmartSchoolAPI ALERT" "failures=$($state.ConsecutiveFailures) detail=$detail"}else{Log "FAIL" "failures=$($state.ConsecutiveFailures) detail=$detail"};$state.IsHealthy=$false}
if(-not ($state.PSObject.Properties.Name -contains "LastStatus")){$state|Add-Member -NotePropertyName LastStatus -NotePropertyValue 0};if(-not ($state.PSObject.Properties.Name -contains "LastLatencyMs")){$state|Add-Member -NotePropertyName LastLatencyMs -NotePropertyValue 0}
$state.LastStatus=$status;$state.LastLatencyMs=$latency;$state|ConvertTo-Json|Set-Content $stateFile -Encoding UTF8
