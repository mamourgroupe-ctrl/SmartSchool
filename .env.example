SMARTSCHOOL_JWT_KEY=replace-with-a-random-development-key-at-least-32-bytes
SMARTSCHOOL_DEV_ADMIN_PASSWORD=choose-a-development-only-password
SMARTSCHOOL_API_BASE_URL_WINDOWS=http://127.0.0.1:5197
SMARTSCHOOL_API_BASE_URL_ANDROID=http://10.0.2.2:5197
# Comma-separated CORS origins for the ASP.NET Core API (optional in Development;
# production fails closed when no origins are configured).
# SMARTSCHOOL_CORS_ORIGINS=https://app.example.com,https://admin.example.com
